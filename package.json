{
  "name": "preaudit",
  "private": true,
  "version": "0.1.0",
  "description": "通信工程造价结算 AI 预审分析工具 —— 根启动脚本（编排 backend / ai-service / frontend）",
  "scripts": {
    "dev": "node scripts/dev-start.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:ai": "node scripts/run-ai.js",
    "dev:web": "cd frontend && npm run dev",
    "build": "npm run build:web",
    "build:web": "cd frontend && npm run build",
    "build:backend": "cd backend && mvn -DskipTests package",
    "daily": "node scripts/daily_prompt.js",
    "daily:build": "node scripts/run-python.js scripts/build_daily_report.py",
    "weekly": "node scripts/run-python.js scripts/build_weekly_report.py",
    "weekly:refresh": "node scripts/run-python.js scripts/build_weekly_report.py",
    "dev:backend:mysql": "node scripts/run-backend.js mysql"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-spawn": "^7.0.3"
  }
}
